# By default the evaluator shells out to the local `claude` CLI, which uses your
# existing Claude subscription / login — no API key needed. Make sure `claude` is
# on PATH and you're signed in (`claude` once interactively, or `/login`).
# To use the z.ai API instead, see the `--- Evaluator ---` section below.

# Where the SQLite database lives.
FAMABOT_DB=./.data/famabot.db

# Persistent Chromium profile directory (holds your logged-in FB session).
FAMABOT_PROFILE_DIR=./.data/chromium-profile

# Run the browser headless for poll/watch. `famabot login` always runs headed.
FAMABOT_HEADLESS=true

# --- Scraping pace (all optional; defaults are deliberately slow) ---
# Newest listings looked at per search, per poll.
FAMABOT_LISTING_CAP=20
# Seconds to wait between opening one listing's detail page and the next.
FAMABOT_DETAIL_GAP_S=30
# Seconds between finishing one search and starting the next.
FAMABOT_SEARCH_GAP_S=120
# Minutes between polls in `watch` (‑i/--interval overrides).
FAMABOT_WATCH_INTERVAL_MIN=90
# Scroll passes per results page: a random count in [min, max] each poll
# (real users don't scroll the same amount every visit), pause between them
# (seconds), and how many scrolls in a row with nothing new before giving up.
FAMABOT_SCROLL_ROUNDS_MIN=3
FAMABOT_SCROLL_ROUNDS_MAX=7
FAMABOT_SCROLL_STALE_LIMIT=2
FAMABOT_SCROLL_PAUSE_S=6
# How many already-tracked listings to re-open per poll (closed / edited detection).
FAMABOT_RECHECK_PER_POLL=8

# --- Candidate notifications (optional) ---
# Comma-separated list of backends to fire when a new candidate is found.
#   telegram  -> Telegram bot message (FAMABOT_TELEGRAM_BOT_TOKEN + _CHAT_ID)
#   ntfy      -> POST to FAMABOT_NTFY_URL (install the ntfy app, pick a topic)
#   command   -> run FAMABOT_NOTIFY_CMD with FAMABOT_TITLE/PRICE/URL/... in the env
#   messenger -> post into FAMABOT_MESSENGER_THREAD using the logged-in browser (fragile)
# e.g. `telegram` or `telegram,ntfy` to fire both.
FAMABOT_NOTIFY=
# Telegram: create a bot with @BotFather for the token; message the bot once,
# then read https://api.telegram.org/bot<token>/getUpdates for your chat id
# (a negative number for a group/channel — add the bot to it first).
FAMABOT_TELEGRAM_BOT_TOKEN=
FAMABOT_TELEGRAM_CHAT_ID=
FAMABOT_NTFY_URL=https://ntfy.sh/change-me-to-something-unguessable
FAMABOT_NOTIFY_CMD=
FAMABOT_MESSENGER_THREAD=
# Suppress pushes for weak candidates (0 = push every candidate). They still
# show up in `browse` / `serve` — this only gates the notification.
FAMABOT_MIN_NOTIFY_SCORE=0.4

# --- Evaluator ---
# Override the evaluator's persona (default: your own local buyer's agent).
FAMABOT_PERSONA=

# Backend for the evaluator:
#   claude-cli  (default) -> local `claude` CLI, your Claude subscription, no key
#   claude-api             -> Anthropic Messages API, needs FAMABOT_CLAUDE_API_KEY
#   codex-cli              -> local `codex` CLI, your ChatGPT subscription, no key
#   codex-api              -> OpenAI Chat Completions API, needs FAMABOT_CODEX_API_KEY
#   zai                    -> z.ai API (GLM), needs FAMABOT_ZAI_API_KEY
FAMABOT_EVALUATOR=claude-cli
# Model for the claude-cli backend (any alias/id `claude --model` accepts).
# Small/fast tier by default — a per-listing yes/no call doesn't need a
# flagship model; bump to e.g. claude-sonnet-5 if you want more.
FAMABOT_EVAL_MODEL=claude-haiku-4-5-20251001

# --- claude-api backend (only used when FAMABOT_EVALUATOR=claude-api) ---
FAMABOT_CLAUDE_API_KEY=
FAMABOT_CLAUDE_API_MODEL=claude-haiku-4-5-20251001
FAMABOT_CLAUDE_API_BASE_URL=https://api.anthropic.com/v1
FAMABOT_CLAUDE_API_MAX_TOKENS=4096
# USD per 1M tokens. Defaults are Anthropic's Claude Haiku 4.5 list price
# (input 1.00 / cached-read 0.10 / output 5.00, 2026). Set all three to 0 to
# disable the cost estimate.
FAMABOT_CLAUDE_API_PRICE_IN=1.00
FAMABOT_CLAUDE_API_PRICE_CACHED=0.10
FAMABOT_CLAUDE_API_PRICE_OUT=5.00

# --- codex-cli backend (only used when FAMABOT_EVALUATOR=codex-cli) ---
# `gpt-5.5` was the only model confirmed to work under ChatGPT-account auth at
# implementation time — OpenAI's API-only model names are rejected by a
# ChatGPT-subscription login. Override if your account/CLI version allows a
# lighter one. No cost estimate: this is subscription usage, not metered
# per-token billing (same as claude-cli).
FAMABOT_CODEX_CLI_MODEL=gpt-5.5

# --- codex-api backend (only used when FAMABOT_EVALUATOR=codex-api) ---
FAMABOT_CODEX_API_KEY=
FAMABOT_CODEX_API_MODEL=gpt-5-mini
FAMABOT_CODEX_API_BASE_URL=https://api.openai.com/v1
FAMABOT_CODEX_API_MAX_TOKENS=4096
# USD per 1M tokens. Defaults are OpenAI's GPT-5-mini list price (input 0.25 /
# cached 0.125 / output 2.00, 2026) — OpenAI's cheap-tier naming turns over
# fast, so double-check platform.openai.com/pricing if this looks stale.
FAMABOT_CODEX_API_PRICE_IN=0.25
FAMABOT_CODEX_API_PRICE_CACHED=0.125
FAMABOT_CODEX_API_PRICE_OUT=2.00

# z.ai backend (only used when FAMABOT_EVALUATOR=zai):
FAMABOT_ZAI_API_KEY=
FAMABOT_ZAI_MODEL=glm-5.3-flash
# Override only if z.ai changes their endpoint.
FAMABOT_ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# GLM-5.x reasoning depth: low | high | max | default.
#   high    (recommended) full summary, ~600-1000 output tok/eval, 7-12s
#   low     terser reasoning, ~1-2 fewer red flags, occasionally drops `verdict`
#           (forces a retry); ~450-550 tok/eval, 4-7s
#   default no hint — over-thinks, ~2000-2500 tok/eval, 20-26s. Not worth it.
FAMABOT_ZAI_REASONING_EFFORT=high
# Completion-token budget (reasoning trace + JSON answer). Only a backstop against
# a runaway trace producing truncated JSON — normal evals use well under this.
# Raise if a log line shows `finish_reason: length`.
FAMABOT_ZAI_MAX_TOKENS=4096
# Model price, USD per 1M tokens. Defaults are z.ai's GLM-5.3-Flash list price
# (input 0.15 / cached input 0.03 / output 0.50, Sept 2026). Each eval stores an
# approximate cost (z.ai returns token counts, not dollars) shown in `browse` /
# `serve` and the `reevaluate` output. Override for a cheaper gateway or another
# GLM model; set all three to 0 to disable the estimate.
FAMABOT_ZAI_PRICE_IN=0.15
FAMABOT_ZAI_PRICE_CACHED=0.03
FAMABOT_ZAI_PRICE_OUT=0.50

# --- Drive-time enrichment (optional) ---
# Provider for the per-listing drive time to `criteria.commute`:
#   ors    -> OpenRouteService (open, free key at openrouteservice.org; NO traffic / time-of-day)
#   google -> Google Routes API (traffic-aware, honours criteria.commute.arriveBy; needs billing)
#   mapbox -> Mapbox Directions (traffic-aware; generous free tier)
FAMABOT_ROUTING=
FAMABOT_ORS_KEY=
FAMABOT_GOOGLE_KEY=
FAMABOT_MAPBOX_TOKEN=
